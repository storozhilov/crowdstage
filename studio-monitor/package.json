{
  "name": "crowdstage-studio-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && esbuild web/main.ts --bundle --format=esm --outfile=dist/app.js && cp web/index.html web/styles.css dist/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "livekit-server-sdk": "2.19.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "livekit-client": "2.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
