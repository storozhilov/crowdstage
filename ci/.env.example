# Copy this file to ci/.env before starting the development stand.
# The dev.sh script also creates ci/.env from this file automatically when needed.

# Pinned LiveKit server image version. Bump it deliberately when upgrading.
LIVEKIT_VERSION=v1.13.11

# Host port for the LiveKit HTTP/WebSocket API and health endpoint.
LIVEKIT_PORT=7880

# Optional override for the host URL used by the scripts and tests to reach
# LiveKit. The default is derived from LIVEKIT_PORT.
# LIVEKIT_URL=ws://127.0.0.1:${LIVEKIT_PORT}

# Host port for the WebRTC TCP fallback.
LIVEKIT_RTC_TCP_PORT=7881

# UDP port range used for WebRTC media. Keep the range small for local development.
LIVEKIT_RTC_UDP_PORT_START=50000
LIVEKIT_RTC_UDP_PORT_END=50060

# Set to true to advertise the host's public IP via STUN.
# Keep false for local development.
LIVEKIT_USE_EXTERNAL_IP=false

# Development API credentials used by clients and token generation.
# Change these if the stand is exposed beyond localhost.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=c597546b0446d0f93625f2d1f8fee42e0f7a0b0318a2626555414e9cd6b6607a

# LiveKit log level: debug, info, warn, or error.
LIVEKIT_LOG_LEVEL=info

# Host port for the MosaicComposer health REST endpoint.
MOSAIC_PORT=7980

# Optional override for the host URL used by the scripts and tests to reach the
# MosaicComposer REST API. The default is derived from MOSAIC_PORT.
# MOSAIC_URL=http://127.0.0.1:${MOSAIC_PORT}

# LiveKit rooms and participant identity used by MosaicComposer.
# MosaicComposer joins MOSAIC_SOURCE_ROOM and publishes the studio background to
# MOSAIC_TARGET_ROOM.
MOSAIC_SOURCE_ROOM=guests
MOSAIC_TARGET_ROOM=mosaic
MOSAIC_IDENTITY=mosaic-composer

# Host port for the MediaMixer health and control REST endpoints.
MEDIA_MIXER_PORT=7981

# Optional override for the host URL used by the scripts and tests to reach the
# MediaMixer REST API. The default is derived from MEDIA_MIXER_PORT.
# MEDIA_MIXER_URL=http://127.0.0.1:${MEDIA_MIXER_PORT}

# LiveKit rooms and participant identity used by MediaMixer.
# MediaMixer joins MEDIA_MIXER_SOURCE_ROOM, tracks its published video streams,
# and forwards the oldest one to MEDIA_MIXER_TARGET_ROOM. When none are
# published it streams a static picture. The number of studio video streams is
# reported as the input count. MEDIA_MIXER_GUEST_ROOM is the room whose guest
# streams can be temporarily broadcasted when selected in MixerConsole, and
# MEDIA_MIXER_MOSAIC_ROOM is the room where MosaicComposer publishes the
# composed output that can be shown on the broadcast the same way.
MEDIA_MIXER_SOURCE_ROOM=studio
MEDIA_MIXER_GUEST_ROOM=guests
# Defaults to MOSAIC_TARGET_ROOM when not set explicitly.
# MEDIA_MIXER_MOSAIC_ROOM=mosaic
MEDIA_MIXER_TARGET_ROOM=broadcast
MEDIA_MIXER_IDENTITY=media-mixer

# Host port for the ControlPlane REST backend used by MixerConsole and
# BusMonitor. ControlPlane issues LiveKit tokens and controls MediaMixer and
# MosaicComposer; media still flows directly through LiveKit.
CONTROL_PLANE_PORT=7982

# Optional override for the host URL used by the scripts and tests to reach
# ControlPlane. The default is derived from CONTROL_PLANE_PORT.
# CONTROL_PLANE_URL=http://127.0.0.1:${CONTROL_PLANE_PORT}

# Optional override for the LiveKit WebSocket URL returned to browsers in
# issued tokens. The default is the host LiveKit URL derived from LIVEKIT_PORT.
# CONTROL_PLANE_LIVEKIT_URL=ws://127.0.0.1:${LIVEKIT_PORT}

# LiveKit rooms exposed through ControlPlane. The defaults follow the media
# component configuration.
# CONTROL_PLANE_BROADCAST_ROOM=broadcast
# CONTROL_PLANE_GUESTS_ROOM=mosaic
# CONTROL_PLANE_GUESTS_SOURCE_ROOM=guests
# CONTROL_PLANE_STUDIO_ROOM=studio

# LiveKit participant identity prefix used for ControlPlane-issued tokens.
CONTROL_PLANE_IDENTITY=control-plane

# Comma-separated browser origins allowed to call ControlPlane. There is no
# wildcard fallback. The default is the MixerConsole, mosaic BusMonitor, and
# broadcast BusMonitor URLs derived from their port variables, including both
# the 127.0.0.1 and localhost loopback aliases.
# CONTROL_PLANE_ALLOWED_ORIGINS=http://127.0.0.1:7991,http://localhost:7991,http://127.0.0.1:7990,http://localhost:7990,http://127.0.0.1:7992,http://localhost:7992

# Optional overrides for ci/media-mixer/run_studio.sh. The base identity defaults
# to studio-<pid>, and the video pattern defaults to a random supported pattern.
# MEDIA_MIXER_STUDIO_IMAGE=livekit/gstreamer:1.26.11-prod-rs
# MEDIA_MIXER_STUDIO_IDENTITY=studio-test
# MEDIA_MIXER_STUDIO_PATTERN=smpte

# Optional overrides for ci/media-mixer/run_audio.sh. The participant identity
# defaults to audio-<pid>, and the wave and frequency default to random
# supported values so concurrent audio publishers are easy to tell apart.
# MEDIA_MIXER_AUDIO_IMAGE=livekit/gstreamer:1.26.11-prod-rs
# MEDIA_MIXER_AUDIO_IDENTITY=audio-test
# MEDIA_MIXER_AUDIO_WAVE=sine
# MEDIA_MIXER_AUDIO_FREQUENCY=440
# MEDIA_MIXER_AUDIO_VOLUME=0.25

# Optional overrides for ci/media-mixer/run_camera.sh. The script creates a
# virtual browser webcam, streams a test pattern through it, and removes the
# camera on exit. On the host it re-executes itself in a privileged container.
# MEDIA_MIXER_CAMERA_FIRST_VIDEO_NR=10
# MEDIA_MIXER_CAMERA_LABEL_PREFIX=CrowdStage Camera
# MEDIA_MIXER_CAMERA_POOL_SIZE=8
# MEDIA_MIXER_CAMERA_PATTERN=smpte75
# MEDIA_MIXER_CAMERA_STATE_DIR=.cache/camera-runs

# Host port for the BusMonitor instance that watches the mosaic target room
# (MOSAIC_TARGET_ROOM).
BUS_MONITOR_MOSAIC_PORT=7990

# Host port for the BusMonitor instance that watches the broadcast room
# (MEDIA_MIXER_TARGET_ROOM).
BUS_MONITOR_BROADCAST_PORT=7992

# Optional overrides for the host URLs used by the scripts and tests to reach
# the BusMonitor instances. The defaults are derived from the port variables.
# BUS_MONITOR_MOSAIC_URL=http://127.0.0.1:${BUS_MONITOR_MOSAIC_PORT}
# BUS_MONITOR_BROADCAST_URL=http://127.0.0.1:${BUS_MONITOR_BROADCAST_PORT}

# BusMonitor uses ControlPlane for LiveKit tokens. The ControlPlane URL is
# derived from CONTROL_PLANE_PORT.

# LiveKit participant identity prefixes used by BusMonitor browser sessions.
BUS_MONITOR_MOSAIC_IDENTITY=bus-monitor-mosaic
BUS_MONITOR_BROADCAST_IDENTITY=bus-monitor-broadcast

# Host port for the MixerConsole web application.
MIXER_CONSOLE_PORT=7991

# Optional override for the host URL used by the scripts and tests to reach
# MixerConsole. The default is derived from MIXER_CONSOLE_PORT.
# MIXER_CONSOLE_URL=http://127.0.0.1:${MIXER_CONSOLE_PORT}

# MixerConsole uses ControlPlane for tokens and subsystem control. The
# ControlPlane URL is derived from CONTROL_PLANE_PORT.
