# Copy this file to ci/.env before starting the development stand.
# The dev.sh script also creates ci/.env from this file automatically when needed.

# Pinned LiveKit server image version. Bump it deliberately when upgrading.
LIVEKIT_VERSION=v1.13.11

# Host port for the LiveKit HTTP/WebSocket API and health endpoint.
LIVEKIT_PORT=7880

# Optional override for the host URL used by the scripts and tests to reach
# LiveKit. The default is derived from LIVEKIT_PORT.
# LIVEKIT_URL=ws://127.0.0.1:${LIVEKIT_PORT}

# Host port for the WebRTC TCP fallback.
LIVEKIT_RTC_TCP_PORT=7881

# UDP port range used for WebRTC media. Keep the range small for local development.
LIVEKIT_RTC_UDP_PORT_START=50000
LIVEKIT_RTC_UDP_PORT_END=50060

# Set to true to advertise the host's public IP via STUN.
# Keep false for local development.
LIVEKIT_USE_EXTERNAL_IP=false

# Development API credentials used by clients and token generation.
# Change these if the stand is exposed beyond localhost.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=c597546b0446d0f93625f2d1f8fee42e0f7a0b0318a2626555414e9cd6b6607a

# LiveKit log level: debug, info, warn, or error.
LIVEKIT_LOG_LEVEL=info

# Host port for the MosaicComposer health REST endpoint.
MOSAIC_PORT=7980

# Optional override for the host URL used by the scripts and tests to reach the
# MosaicComposer REST API. The default is derived from MOSAIC_PORT.
# MOSAIC_URL=http://127.0.0.1:${MOSAIC_PORT}

# LiveKit rooms and participant identity used by MosaicComposer.
# MosaicComposer joins MOSAIC_ROOM and publishes the studio background to MOSAIC_STUDIO_ROOM.
MOSAIC_ROOM=mosaic-composer
MOSAIC_STUDIO_ROOM=studio
MOSAIC_IDENTITY=mosaic-composer

# Host port for the MediaMixer health and control REST endpoints.
MEDIA_MIXER_PORT=7981

# Optional override for the host URL used by the scripts and tests to reach the
# MediaMixer REST API. The default is derived from MEDIA_MIXER_PORT.
# MEDIA_MIXER_URL=http://127.0.0.1:${MEDIA_MIXER_PORT}

# LiveKit rooms and participant identity used by MediaMixer.
# MediaMixer forwards media from MEDIA_MIXER_SOURCE_ROOM to MEDIA_MIXER_TARGET_ROOM.
MEDIA_MIXER_SOURCE_ROOM=studio
MEDIA_MIXER_TARGET_ROOM=broadcast
MEDIA_MIXER_IDENTITY=media-mixer

# Host port for the StudioMonitor web application.
STUDIO_MONITOR_PORT=7990

# Optional override for the host URL used by the scripts and tests to reach
# StudioMonitor. The default is derived from STUDIO_MONITOR_PORT.
# STUDIO_MONITOR_URL=http://127.0.0.1:${STUDIO_MONITOR_PORT}

# Optional override for the LiveKit WebSocket URL used by the browser. The
# default is the host LiveKit URL derived from LIVEKIT_PORT.
# STUDIO_MONITOR_LIVEKIT_URL=ws://127.0.0.1:${LIVEKIT_PORT}

# LiveKit participant identity prefix used by StudioMonitor browser sessions.
STUDIO_MONITOR_IDENTITY=studio-monitor
